!!!
%html
  %head
    %meta{charset: "utf-8"}
    %meta{content: "width=device-width, initial-scale=1", name: "viewport"}
    %title= yield(:title).presence || "Amply"
    :css
      /* Webfonts — грузятся только там, где клиент поддерживает @font-face */
      @font-face {
        font-family: 'Manrope';
        font-style: normal;
        font-weight: 400;
        src: url('#{asset_url("manrope/Manrope-Regular.woff2")}') format('woff2');
      }
      @font-face {
        font-family: 'Manrope';
        font-style: normal;
        font-weight: 500;
        src: url('#{asset_url("manrope/Manrope-Medium.woff2")}') format('woff2');
      }
      @font-face {
        font-family: 'Manrope';
        font-style: normal;
        font-weight: 700;
        src: url('#{asset_url("manrope/Manrope-Bold.woff2")}') format('woff2');
      }

      /* Fallback стек: сначала Manrope, потом системные */
      .font-base {
        font-family: 'Manrope', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif;
      }

      body { margin:0; padding:0; background:#f6f7f9; color:#0f172a; }
      .container { max-width: 600px; margin: 0 auto; padding: 24px 16px; }
      .card { background:#fff; border-radius:16px; padding:24px; box-shadow:0 1px 2px rgba(0,0,0,.04); }

      /* Применяем Manrope к основным элементам */
      .card, .brand__name, h1, h2, h3, p, ul, li, a { font-family: 'Manrope', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif; }
      .brand { display:flex; align-items:center; gap:10px; margin-bottom:16px; }
      .brand__logo { width:24px; height:24px; border-radius:6px; background:#f43f5e; display:inline-block; }
      .brand__name { font-weight:700; }
      h1 { font-weight:700; font-size:22px; line-height:1.25; margin: 12px 0 12px; }
      p { font-weight:400; font-size:16px; line-height:1.6; margin: 0 0 14px; }
      ul { padding-left: 20px; margin: 0 0 16px; }
      li { margin: 4px 0; }
      .muted { color:#6b7280; font-size:12px; line-height:1.6; }
      .button { display:inline-block; background:#ef4444; color:#fff !important; text-decoration:none; padding:10px 16px; border-radius:999px; font-weight:600; }

  %body
    .container
      .card
        = yield
    .container.footer
      %p.muted © #{Time.current.year} Amply — All rights reserved
