%header.app-header.l-page__header.container{data: {controller: "anchor"}}
  = link_to root_path, class: "app-header__logo" do
    = image_tag "shared/logos/amply-logo.svg", alt: "Amply"

  %nav.app-header__nav
    %span.app-header__nav--item{ data: { action: "click->anchor#anchorScrollBlock", anchor: "features" } }
      Features
    %span.app-header__nav--item{ data: { action: "click->anchor#anchorScrollBlock", anchor: "segments" } }
      Who is for
    %span.app-header__nav--item{ data: { action: "click->anchor#anchorScrollBlock", anchor: "waitlist" } }
      Early access
